# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
visual-diff-out/

# --- Spec Kit / BMAD tool scaffolding (regenerated by `specify init` / `npx bmad-method install`) ---
# Kept on disk so /sdd + the per-phase commands work locally, but untracked — rerun the installer on a
# fresh clone to restore. The spec WORK (specs/) and the constitution (.specify/memory/) stay tracked.
.specify/*
!.specify/memory/
.gemini/commands/speckit.*.toml
.agents/claude/skills/speckit-*/
# Spec Kit 0.11 installs the Claude phase skills here (the line above is the kit's stale path):
.claude/skills/speckit-*/
.bmad-core/
.bmad-*/

# Contentful: generated types + build-time image downloads (regenerated every build)
/src/types/contentful/
/public/cms/
# direnv (secrets) — already matched by .env*, listed explicitly for clarity
.envrc
