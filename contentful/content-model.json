{
  "contentTypes": [
    {
      "sys": {
        "id": "button",
        "type": "ContentType"
      },
      "name": "Button",
      "displayField": "internalName",
      "description": "A call-to-action button. Embed it anywhere a rich-text field allows buttons.",
      "fields": [
        {
          "id": "internalName",
          "name": "Internal name",
          "type": "Symbol",
          "localized": false,
          "required": true,
          "validations": [],
          "disabled": false,
          "omitted": false
        },
        {
          "id": "label",
          "name": "Label",
          "type": "Symbol",
          "localized": false,
          "required": true,
          "validations": [],
          "disabled": false,
          "omitted": false
        },
        {
          "id": "url",
          "name": "URL",
          "type": "Symbol",
          "localized": false,
          "required": true,
          "validations": [
            {
              "regexp": {
                "pattern": "^(/[a-z0-9/_-]*|https://\\S+)$"
              },
              "message": "A site path such as /contact, or a full https:// URL"
            }
          ],
          "disabled": false,
          "omitted": false
        }
      ]
    },
    {
      "sys": {
        "id": "hero",
        "type": "ContentType"
      },
      "name": "Hero",
      "displayField": "internalName",
      "description": "The top of a page. Not a block — every page has exactly one.",
      "fields": [
        {
          "id": "internalName",
          "name": "Internal name",
          "type": "Symbol",
          "localized": false,
          "required": true,
          "validations": [],
          "disabled": false,
          "omitted": false
        },
        {
          "id": "headline",
          "name": "Headline",
          "type": "RichText",
          "localized": false,
          "required": true,
          "validations": [
            {
              "enabledMarks": [
                "bold"
              ],
              "message": "Only bold is allowed — bold words render teal"
            },
            {
              "enabledNodeTypes": [
                "embedded-entry-inline",
                "embedded-entry-block"
              ],
              "message": "Only text and embedded buttons"
            },
            {
              "nodes": {
                "embedded-entry-inline": [
                  {
                    "linkContentType": [
                      "button"
                    ],
                    "message": "Only buttons can be embedded"
                  }
                ],
                "embedded-entry-block": [
                  {
                    "linkContentType": [
                      "button"
                    ],
                    "message": "Only buttons can be embedded"
                  }
                ]
              }
            }
          ],
          "disabled": false,
          "omitted": false
        },
        {
          "id": "isAnimated",
          "name": "Animated",
          "type": "Boolean",
          "localized": false,
          "required": true,
          "validations": [],
          "disabled": false,
          "omitted": false
        },
        {
          "id": "media",
          "name": "Media (Slides or Image)",
          "type": "Link",
          "localized": false,
          "required": true,
          "validations": [
            {
              "linkContentType": [
                "heroSlides",
                "heroImage"
              ]
            }
          ],
          "disabled": false,
          "omitted": false,
          "linkType": "Entry"
        }
      ]
    },
    {
      "sys": {
        "id": "heroImage",
        "type": "ContentType"
      },
      "name": "Hero: Image",
      "displayField": "internalName",
      "description": "A single hero image.",
      "fields": [
        {
          "id": "internalName",
          "name": "Internal name",
          "type": "Symbol",
          "localized": false,
          "required": true,
          "validations": [],
          "disabled": false,
          "omitted": false
        },
        {
          "id": "image",
          "name": "Image",
          "type": "Link",
          "localized": false,
          "required": true,
          "validations": [
            {
              "linkMimetypeGroup": [
                "image"
              ]
            }
          ],
          "disabled": false,
          "omitted": false,
          "linkType": "Asset"
        }
      ]
    },
    {
      "sys": {
        "id": "heroSlides",
        "type": "ContentType"
      },
      "name": "Hero: Slides",
      "displayField": "internalName",
      "description": "A slideshow for the hero — at least 3 images.",
      "fields": [
        {
          "id": "internalName",
          "name": "Internal name",
          "type": "Symbol",
          "localized": false,
          "required": true,
          "validations": [],
          "disabled": false,
          "omitted": false
        },
        {
          "id": "images",
          "name": "Images",
          "type": "Array",
          "localized": false,
          "required": true,
          "validations": [
            {
              "size": {
                "min": 3
              },
              "message": "Slides need at least 3 images"
            }
          ],
          "disabled": false,
          "omitted": false,
          "items": {
            "type": "Link",
            "linkType": "Asset",
            "validations": [
              {
                "linkMimetypeGroup": [
                  "image"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "sys": {
        "id": "page",
        "type": "ContentType"
      },
      "name": "Page",
      "displayField": "internalName",
      "description": "A page: one hero, then blocks in drag-and-drop order.",
      "fields": [
        {
          "id": "internalName",
          "name": "Internal name",
          "type": "Symbol",
          "localized": false,
          "required": true,
          "validations": [],
          "disabled": false,
          "omitted": false
        },
        {
          "id": "hero",
          "name": "Hero",
          "type": "Link",
          "localized": false,
          "required": true,
          "validations": [
            {
              "linkContentType": [
                "hero"
              ]
            }
          ],
          "disabled": false,
          "omitted": false,
          "linkType": "Entry"
        },
        {
          "id": "blocks",
          "name": "Blocks",
          "type": "Array",
          "localized": false,
          "required": false,
          "validations": [],
          "disabled": false,
          "omitted": false,
          "items": {
            "type": "Link",
            "linkType": "Entry"
          }
        }
      ]
    }
  ]
}
